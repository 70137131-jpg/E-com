# --- Demo vs production ------------------------------------------------------
# true  = allow the graceful fallbacks below (mock payment gateway, console-only
#         email, fictional brand). Required to run the demo.
# unset = a production build refuses to start while any fallback is active, and
#         names what is missing. Drop this flag first when handing over.
DEMO_MODE=true

# --- Database ----------------------------------------------------------------
DATABASE_URL=                         # Neon pooled connection string

# --- Payments (Stripe test mode) --------------------------------------------
# All three may be left blank: the app falls back to a mock gateway so the
# demo is fully clickable without a Stripe account. See README "Payment modes".
STRIPE_SECRET_KEY=                    # sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # pk_test_...
STRIPE_WEBHOOK_SECRET=                # whsec_...

# --- Email -------------------------------------------------------------------
RESEND_API_KEY=                       # re_...  blank = log to console
EMAIL_FROM=                           # "Brand <orders@yourdomain>"

# --- Admin -------------------------------------------------------------------
ADMIN_PASSWORD=                       # long random string
ADMIN_COOKIE_SECRET=                  # 32+ random bytes, hex

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=                 # https://...  no trailing slash
NEXT_PUBLIC_BRAND_NAME=
COMMERCE_PROVIDER=local               # local | shopify
